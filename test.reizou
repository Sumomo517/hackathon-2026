<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>冷蔵庫の持ち主は誰だ！？ - 冷蔵庫プロファイルゲーム</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Vue.js 3 (CDN) -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400;500&family=Murecho:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Murecho', 'Kiwi Maru', sans-serif;
            background-color: #f0f7f4;
        }
        /* 冷蔵庫の立体感アニメーション */
        .fridge-door {
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }
        .fridge-door.open {
            transform: rotateY(-110deg);
        }
        .perspective {
            perspective: 1200px;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

<div id="app" class="w-full max-w-4xl bg-white rounded-3xl shadow-2xl overflow-hidden border-4 border-emerald-600 flex flex-col md:flex-row min-h-[600px] relative" v-cloak>
    
    <!-- 音声再生のためのユーザーインタラクション促進用トグル (最初はミュート設定可能) -->
    <button @click="toggleMute" class="absolute top-4 right-4 bg-white/80 backdrop-blur-sm p-3 rounded-full shadow-lg border border-gray-200 hover:bg-gray-100 transition z-50">
        <span v-if="muted" class="text-xl">🔇</span>
        <span v-else class="text-xl">🔊</span>
    </button>

    <!-- コピー完了通知（トースト） -->
    <div v-if="showToast" class="absolute top-4 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-6 py-3 rounded-full shadow-xl text-sm font-bold z-50 animate-bounce">
        📋 結果をクリップボードにコピーしました！
    </div>

    <!-- 1. スタート画面 -->
    <div v-if="gameState === 'start'" class="w-full flex flex-col items-center justify-center p-8 text-center bg-gradient-to-br from-emerald-50 to-teal-100">
        <div class="mb-6 text-8xl animate-bounce">🚪❄️</div>
        <h1 class="text-3xl md:text-5xl font-black text-emerald-800 mb-4 tracking-wider leading-snug">
            冷蔵庫の持ち主は誰だ！？<br>
            <span class="text-2xl md:text-3xl text-teal-600 font-bold">〜中身で暴くプロファイル〜</span>
        </h1>
        <p class="text-gray-700 max-w-lg mb-8 leading-relaxed text-sm md:text-base">
            冷蔵庫を開けて中身を調査し、そのラインナップから「だれの冷蔵庫か」を推理するゲームです。各アイテムをクリックすると詳しい調査メモが見られます。
        </p>
        <button @click="startGame" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold text-xl px-12 py-5 rounded-2xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
            ゲームスタート！
        </button>
    </div>

    <!-- 2. ゲーム本編画面 -->
    <div v-if="gameState === 'playing'" class="w-full flex flex-col md:flex-row">
        <!-- 左半分：冷蔵庫ビジュアルエリア -->
        <div class="w-full md:w-1/2 bg-slate-100 p-6 flex flex-col items-center justify-center border-r-0 md:border-r-4 border-dashed border-gray-300 relative min-h-[400px]">
            
            <!-- ラウンド情報 -->
            <div class="absolute top-4 left-4 bg-emerald-600 text-white px-4 py-1.5 rounded-full text-sm font-bold shadow-md z-10">
                ステージ {{ currentRound + 1 }} / {{ totalRounds }}
            </div>

            <!-- ドアを開ける案内（開いていないとき） -->
            <div v-if="!doorOpened" class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center z-20 rounded-t-3xl md:rounded-l-3xl md:rounded-r-none transition-opacity duration-300">
                <button @click="openFridge" class="bg-yellow-400 hover:bg-yellow-500 text-slate-900 font-bold px-8 py-4 rounded-xl shadow-2xl animate-pulse text-lg flex items-center gap-2">
                    <span>❄️ 冷蔵庫を開ける</span>
                </button>
            </div>

            <!-- 立体冷蔵庫コンテナ -->
            <div class="perspective w-64 h-[400px] relative mt-6">
                <!-- 冷蔵庫の内部（背板・棚・中身） -->
                <div class="absolute inset-0 bg-cyan-50 rounded-lg border-4 border-slate-300 shadow-inner overflow-hidden flex flex-col justify-between p-4">
                    <!-- 冷気エフェクト -->
                    <div class="absolute inset-0 bg-gradient-to-b from-white/40 to-transparent pointer-events-none animate-pulse"></div>
                    
                    <!-- 1段目 -->
                    <div class="h-24 border-b-2 border-cyan-100 flex items-end justify-around pb-1 relative">
                        <div v-for="(item, index) in currentRoundData.items.slice(0, 2)" 
                             :key="index"
                             @click="selectItem(item)"
                             class="cursor-pointer group flex flex-col items-center relative transition-transform transform hover:scale-110">
                            <span class="text-3xl filter drop-shadow">{{ item.emoji }}</span>
                            <span class="text-[10px] bg-white/90 px-1 rounded border border-gray-200 shadow-sm mt-1 whitespace-nowrap">{{ item.name }}</span>
                        </div>
                    </div>

                    <!-- 2段目 -->
                    <div class="h-24 border-b-2 border-cyan-100 flex items-end justify-around pb-1 relative">
                        <div v-for="(item, index) in currentRoundData.items.slice(2, 4)" 
                             :key="index"
                             @click="selectItem(item)"
                             class="cursor-pointer group flex flex-col items-center relative transition-transform transform hover:scale-110">
                            <span class="text-3xl filter drop-shadow">{{ item.emoji }}</span>
                            <span class="text-[10px] bg-white/90 px-1 rounded border border-gray-200 shadow-sm mt-1 whitespace-nowrap">{{ item.name }}</span>
                        </div>
                    </div>

                    <!-- 3段目 (野菜室やメインポケットイメージ) -->
                    <div class="h-24 flex items-end justify-around pb-1 relative">
                        <div v-for="(item, index) in currentRoundData.items.slice(4, 5)" 
                             :key="index"
                             @click="selectItem(item)"
                             class="cursor-pointer group flex flex-col items-center relative transition-transform transform hover:scale-110">
                            <span class="text-4xl filter drop-shadow animate-bounce" style="animation-duration: 3s;">{{ item.emoji }}</span>
                            <span class="text-[10px] bg-white/90 px-1 rounded border border-gray-200 shadow-sm mt-1 whitespace-nowrap">{{ item.name }}</span>
                        </div>
                    </div>
                </div>

                <!-- 冷蔵庫のドア（開閉パーツ） -->
                <div :class="['fridge-door absolute inset-0 bg-slate-200 rounded-lg border-4 border-slate-300 shadow-md origin-left flex items-center justify-end pr-4 cursor-pointer', doorOpened ? 'open' : '']"
                     @click="openFridge">
                    <!-- ドアの取っ手 -->
                    <div class="w-4 h-24 bg-slate-400 rounded-full shadow-inner border border-slate-500"></div>
                    <!-- ロゴ風デザイン -->
                    <div class="absolute top-6 left-6 text-slate-400 font-bold text-xs tracking-widest">COOL-TECH</div>
                </div>
            </div>

            <p class="text-xs text-gray-500 mt-4 text-center">
                ※冷蔵庫の中のアイテムをタップすると詳細情報を調べられます！
            </p>
        </div>

        <!-- 右半分：推理＆クイズ操作エリア -->
        <div class="w-full md:w-1/2 p-6 flex flex-col justify-between bg-white">
            <div>
                <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
                    🔍 <span>冷蔵庫の分析カルテ</span>
                </h2>

                <!-- 選択したアイテムの詳細メモ -->
                <div class="bg-emerald-50 rounded-2xl p-4 border border-emerald-100 min-h-[120px] mb-6 transition-all">
                    <div v-if="selectedItem" class="flex gap-3">
                        <div class="text-4xl">{{ selectedItem.emoji }}</div>
                        <div>
                            <h4 class="font-bold text-emerald-800 text-sm md:text-base">{{ selectedItem.name }}</h4>
                            <p class="text-xs md:text-sm text-emerald-700 mt-1 leading-relaxed">{{ selectedItem.desc }}</p>
                        </div>
                    </div>
                    <div v-else class="h-full flex items-center justify-center text-gray-400 text-sm text-center py-6">
                        冷蔵庫の中の食材やアイテムをタップして<br>手がかり（詳細）を調査しよう！
                    </div>
                </div>

                <!-- 選択肢（回答） -->
                <div class="space-y-3">
                    <p class="text-sm font-bold text-gray-600 mb-2">この冷蔵庫の持ち主はだれ？</p>
                    <button 
                        v-for="(option, index) in currentRoundData.options" 
                        :key="index"
                        @click="checkAnswer(option)"
                        :disabled="answered"
                        :class="[
                            'w-full p-4 rounded-xl text-left font-bold border-2 transition-all duration-200 flex justify-between items-center text-sm md:text-base',
                            answered 
                                ? (option === currentRoundData.owner ? 'bg-emerald-100 border-emerald-500 text-emerald-800' : (selectedAnswer === option ? 'bg-rose-100 border-rose-500 text-rose-800' : 'bg-gray-50 border-gray-200 text-gray-400'))
                                : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-emerald-500 hover:text-emerald-700 hover:shadow-md'
                        ]"
                    >
                        <span>{{ option }}</span>
                        <span v-if="answered && option === currentRoundData.owner" class="text-emerald-600 font-bold">⭕ 正解</span>
                        <span v-if="answered && selectedAnswer === option && option !== currentRoundData.owner" class="text-rose-600 font-bold">❌ 不正解</span>
                    </button>
                </div>
            </div>

            <!-- 解説＆次へボタン -->
            <div v-if="answered" class="mt-6 p-4 bg-amber-50 rounded-2xl border border-amber-200 animate-fade-in">
                <h4 class="font-bold text-amber-900 text-sm mb-1">💡 推理の解説:</h4>
                <p class="text-xs md:text-sm text-amber-800 leading-relaxed mb-4">{{ currentRoundData.explanation }}</p>
                <button @click="nextRound" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-6 rounded-xl shadow-md transition-all text-center">
                    {{ isLastRound ? '最終結果を見る' : '次の冷蔵庫へ ➔' }}
                </button>
            </div>
        </div>
    </div>

    <!-- 3. 結果発表画面 -->
    <div v-if="gameState === 'result'" class="w-full flex flex-col items-center justify-center p-8 text-center bg-gradient-to-br from-emerald-50 to-teal-100">
        <div class="mb-4 text-8xl">🏆</div>
        <h2 class="text-3xl font-black text-emerald-800 mb-2">捜査完了！</h2>
        <p class="text-gray-600 mb-6 font-medium">冷蔵庫プロファイルの結果を発表します</p>

        <div class="bg-white p-6 rounded-3xl shadow-xl border-2 border-emerald-400 max-w-sm w-full mb-6">
            <p class="text-sm text-gray-500 font-bold">あなたの正解率</p>
            <p class="text-5xl font-black text-emerald-600 my-3">{{ score }} / {{ totalRounds }}</p>
            <div class="text-lg font-bold text-slate-700 border-t pt-3 mt-3">
                称号: <span class="text-emerald-700 font-black">{{ evalTitle }}</span>
            </div>
            <p class="text-xs text-gray-500 mt-2 leading-relaxed">{{ evalComment }}</p>
        </div>

        <!-- 共有（シェア）セクション -->
        <div class="flex flex-col gap-2 w-full max-w-sm mb-8 bg-white/80 backdrop-blur-sm p-4 rounded-2xl border border-teal-100 shadow-sm">
            <p class="text-xs font-bold text-emerald-800 tracking-wide">🔍 結果を友達にシェアする</p>
            <div class="grid grid-cols-3 gap-2 mt-1">
                <button @click="shareOnX" class="bg-black hover:bg-slate-900 text-white py-2.5 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1 transition">
                    <span class="text-sm">𝕏</span> Share
                </button>
                <button @click="shareOnLine" class="bg-[#06C755] hover:bg-[#05b04b] text-white py-2.5 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1 transition">
                    <span class="text-sm">💬</span> LINE
                </button>
                <button @click="copyResult" class="bg-slate-600 hover:bg-slate-700 text-white py-2.5 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1 transition">
                    <span class="text-sm">📋</span> コピー
                </button>
            </div>
        </div>

        <div class="flex gap-4">
            <button @click="restartGame" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold px-8 py-4 rounded-2xl shadow-lg transition">
                もう一度遊ぶ
            </button>
        </div>
    </div>

</div>

<!-- Vue.js アプリケーションコード -->
<script>
const { createApp, ref, computed } = Vue;

createApp({
    setup() {
        const gameState = ref('start'); // start, playing, result
        const currentRound = ref(0);
        const score = ref(0);
        const doorOpened = ref(false);
        const selectedItem = ref(null);
        const answered = ref(false);
        const selectedAnswer = ref(null);
        const muted = ref(false);
        const showToast = ref(false); // コピー完了トースト用

        // オーディオコンテキストの作成 (Web Audio API)
        let audioCtx = null;
        const initAudio = () => {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        };

        // サウンド再生ヘルパー
        const playSound = (type) => {
            if (muted.value) return;
            initAudio();
            if (!audioCtx) return;

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'door') {
                // ドアを開けるシューという風のような音
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(150, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + 0.5);
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.5);
            } else if (type === 'correct') {
                // 正解のピンポン！
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
                osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1); // E5
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.4);
            } else if (type === 'wrong') {
                // 不正解のブー
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, audioCtx.currentTime);
                osc.frequency.setValueAtTime(145, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'select') {
                // アイテム選択音
                osc.type = 'sine';
                osc.frequency.setValueAtTime(800, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            }
        };

        const toggleMute = () => {
            muted.value = !muted.value;
        };

        // 冷蔵庫データ
        const rounds = ref([
            {
                owner: "筋トレマニアのパーソナルトレーナー",
                options: [
                    "筋トレマニアのパーソナルトレーナー",
                    "実家暮らしの女子大生",
                    "超多忙なITスタートアップ社長",
                    "こだわりの料理研究家"
                ],
                explanation: "プロテイン、皮なしの鶏むね肉、大量の卵にブロッコリーなど、とにかく「高タンパク・低脂質」の食品が隙間なく並んでいます。筋肉のための徹底した栄養管理が見て取れます！",
                items: [
                    { name: "皮なし鶏むね肉", emoji: "🥩", desc: "高タンパク低カロリーの王様。常にストックを切らしません。" },
                    { name: "ブロッコリー", emoji: "🥦", desc: "ビタミン・ミネラルが豊富で、バルクアップ中も重宝するマスト野菜。" },
                    { name: "プロテインシェイカー", emoji: "🥤", desc: "トレーニング後に素早く補給するための、お気に入りのマイシェイカー。" },
                    { name: "大量の卵 (3パック)", emoji: "🥚", desc: "アミノ酸スコア100。毎日白身を中心に大量消費します。" },
                    { name: "ギリシャヨーグルト", emoji: "🥣", desc: "脂質ゼロかつ高タンパク。甘さ控えめでデザート代わりに。" }
                ]
            },
            {
                owner: "限界一人暮らしの男子大学生",
                options: [
                    "節約志向の主婦",
                    "限界一人暮らしの男子大学生",
                    "下町の頑固な居酒屋店主",
                    "ヴィーガンのヨガインストラクター"
                ],
                explanation: "半額シール付きのお惣菜、ほぼ空っぽのマヨネーズ、飲みかけで期限間近の牛乳、そして炭水化物だけの冷凍うどん。生活感と節約の苦労が滲み出る冷蔵庫です。",
                items: [
                    { name: "半額シールの惣菜", emoji: "🍱", desc: "夜20時以降のスーパーで勝ち取ったコロッケ。貴重なおかずです。" },
                    { name: "ストロング系缶チューハイ", emoji: "🍺", desc: "安く手っ取り早く酔える、大学生の夜の相棒。" },
                    { name: "残りわずかのマヨネーズ", emoji: "🧴", desc: "容器がへこんで限界を迎えている。絞り出して使います。" },
                    { name: "冷凍うどん", emoji: "🍜", desc: "安くて簡単で腹にたまる、主食の防衛ライン。" },
                    { name: "期限が怪しい牛乳", emoji: "🥛", desc: "あと2日は大丈夫…と自分に言い聞かせて飲んでいます。" }
                ]
            },
            {
                owner: "超多忙なITスタートアップ社長",
                options: [
                    "プロのパティシエ",
                    "ガジェットオタクの会社員",
                    "超多忙なITスタートアップ社長",
                    "育ち盛りの子どもがいるママ"
                ],
                explanation: "冷蔵庫の中に「食材」としての固形物はほとんどありません。あるのはエネルギー補給用のエナジードリンク、即座に栄養になるゼリー飲料、そして来客用と思われる高級シャンパン。超効率と激務の証です。",
                items: [
                    { name: "エナジードリンク (箱買い)", emoji: "🥫", desc: "睡眠時間を削って働くためのカフェイン燃料。" },
                    { name: "高級ブランドのシャンパン", emoji: "🍾", desc: "融資や大きな契約が決まったときのお祝い用、あるいは来客用。" },
                    { name: "高級板チョコレート", emoji: "🍫", desc: "デスクワークで疲れた脳に糖分を急速補給するためのご褒美。" },
                    { name: "パウチゼリー飲料", emoji: "🥤", desc: "パソコンを叩きながら10秒で朝食を済ませるためのアイテム。" },
                    { name: "大量のミネラルウォーター", emoji: "💧", desc: "海外製の高価なシリカ水。水分補給は欠かしません。" }
                ]
            },
            {
                owner: "ヴィーガンのヨガインストラクター",
                options: [
                    "肉料理専門のシェフ",
                    "ヴィーガンのヨガインストラクター",
                    "食べ盛りの５人家族",
                    "スイーツブロガー"
                ],
                explanation: "アーモンドミルク、熟したアボカド、カラフルな無農薬野菜にスーパーフード。動物性タンパク質（肉・魚・乳製品・卵）が一切なく、内側から体を整えるこだわりが詰まっています。",
                items: [
                    { name: "無農薬アボカド", emoji: "🥑", desc: "良質な脂質（森のバター）を摂取するための主食級食材。" },
                    { name: "アーモンドミルク", emoji: "🥛", desc: "牛乳の代わりに料理やチャイに使う植物性ミルク。" },
                    { name: "自家製コンブチャ", emoji: "🏺", desc: "腸内環境を整えるために自分で発酵させている謎の液体。" },
                    { name: "カラフルな有機野菜", emoji: "🥬", desc: "ケール、パプリカ、チアシードなど、デトックス用の食材。" },
                    { name: "新鮮なハーブ", emoji: "🌿", desc: "ミントやバジル。サラダやデトックスウォーターに浮かべます。" }
                ]
            },
            {
                owner: "３人の子どもを育てる大家族のママ",
                options: [
                    "一人暮らしのOL",
                    "ミニマリストの男性",
                    "３人の子どもを育てる大家族のママ",
                    "お酒が大好きなバーテンダー"
                ],
                explanation: "1リットルの牛乳が3本もあり、作り置きの巨大なカレー鍋、子供たち用のデザート。とにかく全員のお腹を満たすための圧倒的なボリュームと愛情に溢れています！",
                items: [
                    { name: "巨大なカレーの鍋", emoji: "🍲", desc: "2日目のカレー。これさえあれば食べ盛りの子供たちも大満足！" },
                    { name: "牛乳が3本", emoji: "🥛", desc: "子供たちがガブガブ飲むため、3日ともちません。" },
                    { name: "ウインナーの徳用パック", emoji: "🌭", desc: "お弁当や朝食の必需品。とにかく量が多いパック。" },
                    { name: "キャラクタープリン", emoji: "🍮", desc: "3つの山。おやつ時の争奪戦を避けるために同じものを3個。" },
                    { name: "作り置きのおかずタッパー", emoji: "🍱", desc: "きんぴらやひじき。夕食を少しでも時短するためのママの知恵。" }
                ]
            }
        ]);

        const currentRoundData = computed(() => rounds.value[currentRound.value]);
        const totalRounds = computed(() => rounds.value.length);
        const isLastRound = computed(() => currentRound.value === totalRounds.value - 1);

        // ランク判定
        const evalTitle = computed(() => {
            const ratio = score.value / totalRounds.value;
            if (ratio === 1) return "超一流冷蔵庫プロファイラー";
            if (ratio >= 0.8) return "ベテラン冷蔵庫捜査官";
            if (ratio >= 0.5) return "新米探偵級";
            return "通りすがりの主婦（夫）レベル";
        });

        const evalComment = computed(() => {
            const ratio = score.value / totalRounds.value;
            if (ratio === 1) return "完璧な推理です！食材一つひとつのこだわりや生活背景を瞬時に見抜くその眼力は、プロの捜査官顔負けです。";
            if (ratio >= 0.8) return "素晴らしい観察力！持ち主のライフスタイルをほぼ的確にイメージできています。あと一歩でパーフェクト！";
            if (ratio >= 0.5) return "なかなかのプロファイリングセンスです。中身から見えてくる「人間性」に、もう少しフォーカスすると精度が上がるかも！";
            return "冷蔵庫の捜査は一筋縄ではいきません。もう少しアイテムの細部に隠されたヒントに注目してみましょう！";
        });

        // ゲームコントロール
        const startGame = () => {
            initAudio();
            gameState.value = 'playing';
            currentRound.value = 0;
            score.value = 0;
            resetRoundState();
        };

        const openFridge = () => {
            if (!doorOpened.value) {
                doorOpened.value = true;
                playSound('door');
            }
        };

        const selectItem = (item) => {
            selectedItem.value = item;
            playSound('select');
        };

        const checkAnswer = (option) => {
            if (answered.value) return;
            selectedAnswer.value = option;
            answered.value = true;

            if (option === currentRoundData.value.owner) {
                score.value++;
                playSound('correct');
            } else {
                playSound('wrong');
            }
        };

        const nextRound = () => {
            if (isLastRound.value) {
                gameState.value = 'result';
            } else {
                currentRound.value++;
                resetRoundState();
            }
        };

        const resetRoundState = () => {
            doorOpened.value = false;
            selectedItem.value = null;
            answered.value = false;
            selectedAnswer.value = null;
        };

        const restartGame = () => {
            gameState.value = 'start';
        };

        // 共有テキストの自動生成
        const shareText = computed(() => {
            return `【冷蔵庫の持ち主は誰だ！？】\nプロファイル結果: ${score.value}/${totalRounds.value} 正解！\n称号: 「${evalTitle.value}」\n\n冷蔵庫の中身から持ち主を推理するゲームに挑戦したよ！君もプロファイルできるかな？\n#冷蔵庫プロファイルゲーム`;
        });

        // X (旧Twitter) への共有
        const shareOnX = () => {
            const url = encodeURIComponent(window.location.href);
            const text = encodeURIComponent(shareText.value);
            window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank');
        };

        // LINE への共有
        const shareOnLine = () => {
            const url = encodeURIComponent(window.location.href);
            const text = encodeURIComponent(shareText.value);
            window.open(`https://social-plugins.line.me/lineit/share?url=${url}&text=${text}`, '_blank');
        };

        // クリップボードへの結果コピー
        const copyResult = () => {
            const textToCopy = `${shareText.value}\nゲームのURL: ${window.location.href}`;
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = textToCopy;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            
            try {
                document.execCommand('copy');
                showToast.value = true;
                setTimeout(() => {
                    showToast.value = false;
                }, 2000);
            } catch (err) {
                console.error('コピーに失敗しました', err);
            }
            document.body.removeChild(tempTextArea);
        };

        return {
            gameState,
            currentRound,
            score,
            doorOpened,
            selectedItem,
            answered,
            selectedAnswer,
            rounds,
            currentRoundData,
            totalRounds,
            isLastRound,
            evalTitle,
            evalComment,
            muted,
            toggleMute,
            showToast,
            startGame,
            openFridge,
            selectItem,
            checkAnswer,
            nextRound,
            restartGame,
            shareOnX,
            shareOnLine,
            copyResult
        };
    }
}).mount('#app');
</script>

</body>
</html>